    "clang-wasi": "https://github.com/breeze833/clang-wasi/releases/download/v19.1.0/clang-wasi-19.1.0.tgz",
    "jszip": "^3.10.1",
    "make-wasi": "https://github.com/breeze833/make-wasi/releases/download/latest/make-wasi-4.4.1.tgz",
    "monaco-editor": "^0.52.2",
    "raylib-wasi": "https://github.com/breeze833/raylib-wasi/releases/download/latest/raylib-wasi-5.5.0.tgz",
    "sqlite-wasi": "https://github.com/breeze833/sqlite-wasi/releases/download/v3.54.1/sqlite-wasi-3.54.1.tgz",
    "stdin-wasi": "https://github.com/breeze833/stdin-wasi/releases/download/v0.1.0/stdin-wasi-0.1.0.tgz",
